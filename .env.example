# ==========================================
# DEAR YOU — ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Public Configuration (Browser accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Recipient Session JWT Secret (Used for signing gift access cookies)
RECIPIENT_JWT_SECRET=your-random-32-character-secret-key-for-recipient-session

# Base URL of application (for absolute links in previews/emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# EMAIL DELIVERY (Gmail SMTP / Nodemailer)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Dear You" <your-email@gmail.com>

# ==========================================
# MOBILE SMS GATEWAY (Optional)
# ==========================================
# FAST2SMS_API_KEY=your-fast2sms-api-key
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number
