# ==========================================
# DEAR YOU — ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Public Configuration (Browser accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Recipient Session JWT Secret (Used for signing gift access cookies)
RECIPIENT_JWT_SECRET=your-random-32-character-secret-key-for-recipient-session

# Base URL of application (for absolute links in previews/emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
